---
// HOMEPAGE V5 — T.O.U.R. News (visual-align, image-led hero overlay, evidence-safe ticker)
import TourBase from '../layouts/TourBase.astro';
import EvidenceLabel from '../components/EvidenceLabel.astro';
import EditionCard from '../components/EditionCard.astro';
import dossier from '../data/dossier-banco-master.json';
import editionsIndex from '../data/editions-index.json';

const current = editionsIndex.editions[0];
const lead = current.leadStory;

// Real developments: edition whatChanged (has real clock times) + recent dossier timeline dates
const changed = current.whatChanged || [];
const liveUpdates = [...changed].slice(0, 4).map((c, i) => ({
  time: (c.time || '').padStart(5, '0'),
  kind: c.kind || (c.label || 'DEVELOPMENT'),
  text: c.text,
}));

// BREAKING ticker: material items from real edition updates (no invented alerts)
const tickerItems = [...changed].slice(0, 3).map((c) => ({
  time: (c.time || '').padStart(5, '0'),
  text: c.text,
}));
const renderTicker = tickerItems.length
  ? tickerItems
  : [{ time: '—', text: 'Dossier monitoring continues — no material alert this window.' }];

const topStories = [
  { tag: 'UNITED STATES', accent: '#1e3a8a', size: 'large',
    headline: lead.headline,
    deck: lead.deck,
    img: lead.cover && lead.cover.startsWith('/') ? lead.cover : '/media/hero-banco-master.jpg', href: lead.href, readingMin: lead.readingMin || 5 },
  { tag: 'WORLD', accent: '#1e4d8c', size: 'small',
    headline: 'Watchlist: four flashpoints entering a volatile month',
    deck: 'Confirmed deployments only — monitoring desk.',
    img: '/media/tour-world-globe.jpg', href: '/topics#world' },
  { tag: 'BRAZIL', accent: '#166534', size: 'small',
    headline: 'Congress returns with three integrity probes on the calendar',
    deck: 'What each one can actually subpoena.',
    img: null, href: '/topics#brazil' },
];
const largeStory = topStories.find(s => s.size === 'large');
const smallStories = topStories.filter(s => s.size === 'small');
const sideStories = [
  { tag: 'US IMMIGRATION', accent: '#b91c1c', headline: 'The worksite raid playbook, annotated', deck: 'Every step is public record.', href: '/topics#us-immigration' },
  { tag: 'BUSINESS', accent: '#7c2d12', headline: 'Banco Master\u2019s depositors: where the guarantee stands', deck: 'The fund mechanics, documented.', href: '/dossier/banco-master' },
  { tag: 'WAR & SECURITY', accent: '#57534e', headline: 'Watchlist: four flashpoints entering a volatile month', deck: 'Confirmed deployments only.', href: '/topics#war-security' },
];
const documents = [
  { title: 'PF forensic report (IPJ-A)', slug: 'pf-report', meta: 'Polícia Federal · Aug 27, 2026' },
  { title: 'Barci de Moraes ↔ Banco Master contract', slug: 'barci-contract', meta: 'Case file PET 16662 · 2024' },
  { title: 'Fachin order (despacho)', slug: 'fachin-order', meta: 'STF Presidency · Sep 3, 2026' },
  { title: 'PGR manifestation', slug: 'pgr-brief', meta: 'PGR/ASSCRIM · Sep 2026' },
];
const learnMoreLinks = [
  { label: 'Documents', href: '/dossier/banco-master#documents' },
  { label: 'Timeline', href: '/dossier/banco-master#timeline' },
  { label: 'Key Players', href: '/dossier/banco-master#players' },
  { label: 'What We Know', href: '/dossier/banco-master#known' },
  { label: 'What\u2019s Next', href: '/dossier/banco-master#analysis' },
];
---
<TourBase activeNav="home">
  <!-- 4. BREAKING TICKER (RED) -->
  <div class="breaking-bar">
    <span class="breaking-label"><span class="bl-dot"></span>BREAKING</span>
    <div class="breaking-items">
      {renderTicker.map((u, i) => (
        <span class="breaking-item" key={i}><b>{u.time} CT</b> — {u.text.slice(0, 110)}{u.text.length > 110 ? '…' : ''}</span>
      ))}
    </div>
  </div>

  <!-- 5. HERO OVERLAY + 6. LIVE UPDATES RAIL -->
  <section class="hero-zone">
    <article class="hero-main">
      <div class="hero-img-wrap">
        <img src={current.cover} alt={current.coverAlt} loading="eager" fetchpriority="high" />
        <div class="hero-scrim"></div>
        <div class="hero-content">
          <div class="hero-topline">
            <span class="hero-badge">{lead.desk.replace(/-/g,' ').toUpperCase()}</span>
            <span class="hero-kind">DEVELOPING</span>
          </div>
          <h1><a href={lead.href}>{lead.headline}</a></h1>
          <p class="deck">{lead.deck}</p>
          <div class="cta-row">
            <a class="btn solid" href={lead.href}>READ</a>
            <a class="btn line" href="/editions/">▶ LISTEN</a>
            <a class="btn line" href="/editions#listen">▶ WATCH</a>
            <a class="btn line" href="/dossier/banco-master">SEE RECEIPTS</a>
          </div>
        </div>
      </div>
    </article>
    <aside class="live-rail">
      <div class="rail-head"><span class="pulse">●</span> LIVE UPDATES <a href="/dossier/banco-master">view all</a></div>
      {liveUpdates.length ? liveUpdates.map((u, i) => (
        <div class="rail-item">
          <div class="rail-top"><span class="rail-time">{u.time} CT</span><span class="rail-kind">{u.kind}</span></div>
          <p>{u.text}</p>
        </div>
      )) : (
        <div class="rail-item"><div class="rail-top"><span class="rail-time">—</span><span class="rail-kind">MONITORING</span></div><p>No material development since last edition. Next edition 07:00 CT.</p></div>
      )}
      <div class="rail-cta">
        <a class="rail-cta-item" href="/editions/"><span>▶</span> LISTEN — Evening Brief <em>1:30</em></a>
      </div>
    </aside>
  </section>

  <!-- 7. TOP STORIES MOSAIC -->
  <div class="section-h">Top stories <span class="sub">graded · sourced · current</span></div>
  <section class="mosaic">
    <article class="mcard large">
      {largeStory.img && <img src={largeStory.img} alt="" loading="lazy" />}
      <div class="mbody">
        <span class="chip" style={`color:${largeStory.accent}`}>{largeStory.tag}</span>
        <h3><a href={largeStory.href}>{largeStory.headline}</a></h3>
        <p>{largeStory.deck}</p>
        <span class="stamp">{largeStory.readingMin} min read</span>
      </div>
    </article>
    <div class="mcol">
      {smallStories.map((s) => (
        <article class="mcard small">
          {s.img && <img src={s.img} alt="" loading="lazy" />}
          <div class="mbody">
            <span class="chip" style={`color:${s.accent}`}>{s.tag}</span>
            <h4><a href={s.href}>{s.headline}</a></h4>
            <p>{s.deck}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="sidestory">
    {sideStories.map((s) => (
      <article class="mcard tiny">
        <span class="chip" style={`color:${s.accent}`}>{s.tag}</span>
        <h4><a href={s.href}>{s.headline}</a></h4>
        <p>{s.deck}</p>
      </article>
    ))}
  </section>

  <!-- 10. PUBLIC INTEGRITY / INVESTIGATION BLOCK -->
  <section class="integrity">
    <div class="int-copy">
      <span class="kicker" style="color:var(--gold-400)">Investigations</span>
      <h2 style="color:var(--cream)">BANCO MASTER <span style="color:var(--gold-400)">— THE DOSSIER</span></h2>
      <p>The banker, the justice, and 52 messages. What a 218-page police forensic report proves — and what it merely suggests. Updated as documents land.</p>
      <div class="int-stats">
        <span><b>{dossier.known_facts.length}</b> verified facts</span>
        <span><b>{dossier.primary_sources.length}</b> documents</span>
        <span><b>{dossier.timeline.length}</b> timeline events</span>
        <span><b>{dossier.contradictions.length}</b> contradictions</span>
      </div>
      <a class="btn gold" href="/dossier/banco-master">OPEN THE DOSSIER</a>
    </div>
    <div class="int-side">
      <div class="int-panel">
        <span class="ip-head">WHAT WE KNOW</span>
        <p>52 one-way messages exist (PF doc). The contract exists (primary doc). Reply content was never recovered.</p>
      </div>
      <div class="int-panel">
        <span class="ip-head">LEARN MORE</span>
        <ul class="llist">
          {learnMoreLinks.map((l) => (<li><a href={l.href}>{l.label} →</a></li>))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 11. BRAZIL + USA BRIDGE -->
  <section class="bridge">
    <div class="bridge-head">
      <span class="flag-big">🇧🇷</span>
      <div>
        <div class="kicker" style="color:var(--gold-400)">The bridge desk</div>
        <h2>TWO COUNTRIES, ONE FEED</h2>
      </div>
      <span class="flag-big">🇺🇸</span>
    </div>
    <p class="bridge-deck">Immigration, trade, politics, democracy — reported from both ends of the bridge, in both languages, with the receipts in both jurisdictions.</p>
    <div class="bridge-links">
      <a href="/topics#us-immigration">US Immigration →</a>
      <a href="/topics#brazil">Brazil →</a>
      <a href="/topics#brazil-public-integrity">Public Integrity →</a>
    </div>
  </section>

  <!-- 12. THE DAILY DESK -->
  <div class="section-h">The Daily Desk <span class="sub">three briefings every day · <a href="/editions/" style="color:var(--red-600)">all editions →</a></span></div>
  <section class="today3">
    <EditionCard type="morning" time="07:00" status="PUBLISHED" cover="/media/hero-banco-master-9x16.jpg" headline="Overnight watch: the five-day clocks and the postponed plenary" storyCount={current.storyCount} readingMin={current.readingMin} updatedTime={current.updatedAt.slice(11,16)} href="/editions/2026-09-06-evening" />
    <EditionCard type="midday" time="13:00" status="PUBLISHED" cover="/media/thumbs/pgr-brief.png" headline="PGR manifestação lands on the case file" updateCount={current.whatChanged.length} updatedTime={current.updatedAt.slice(11,16)} href="/editions/2026-09-06-evening" />
    <EditionCard type="evening" time="19:00" status="CURRENT EDITION" cover={current.cover} headline={current.leadHeadline} storyCount={current.storyCount} readingMin={current.readingMin} updatedTime={current.updatedAt.slice(11,16)} href="/editions/2026-09-06-evening" />
  </section>

  <!-- 13. LATEST VERIFIED -->
  <div class="section-h">Latest verified <span class="sub">fact-first · no commentary</span></div>
  <section class="verified">
    {liveUpdates.map((u, i) => (
      <div class="vitem" key={i}><span class="vtime">{u.time} CT</span><span class="vtext">{u.text}</span></div>
    ))}
    <a class="vall" href="/dossier/banco-master">View all verified updates →</a>
  </section>
</TourBase>

<script>
  // no heavy scripts on homepage
</script>

<style>
  .breaking-bar { margin-bottom: 1.2rem; }
  .hero-zone { display: grid; gap: 1.2rem; margin-bottom: 0.5rem; }
  .hero-zone > * { min-width: 0; }
  img { max-width: 100%; height: auto; }
  @media (min-width: 940px) { .hero-zone { grid-template-columns: minmax(0,1.9fr) minmax(0,1fr); } }
  .hero-main { position: relative; overflow: hidden; min-height: 380px; background: var(--navy-700); }
  .hero-img-wrap { position: absolute; inset: 0; }
  .hero-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-scrim { position: absolute; inset: 0; background: linear-gradient(transparent 35%, rgba(0,16,48,0.88) 88%); }
  .hero-content { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 1.4rem 1.4rem 1.5rem; color: #fff; }
  .hero-topline { display: flex; gap: 0.6rem; align-items: center; margin-bottom: 0.55rem; }
  .hero-badge { font-family: var(--sans); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; background: var(--red-600); color: #fff; padding: 0.18rem 0.55rem; border-radius: 2px; }
  .hero-kind { font-family: var(--sans); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-400); }
  .hero-content h1 { font-size: clamp(1.7rem, 3.6vw, 2.6rem); line-height: 1.1; margin: 0 0 0.4rem; letter-spacing: -0.01em; }
  .hero-content h1 a { color: var(--cream); text-decoration: none; text-shadow: 0 2px 10px rgba(0,0,0,0.4); }
  .hero-content h1 a:hover { color: var(--gold-400); }
  .hero-content .deck { font-size: 1rem; color: rgba(248,248,240,0.88); max-width: 60ch; text-shadow: 0 1px 6px rgba(0,0,0,0.4); }
  .cta-row { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1rem; }
  .btn.line { border-color: rgba(255,255,255,0.65); }

  .live-rail { background: var(--navy-800); color: var(--cream); padding: 1rem 1.1rem; border: 1px solid var(--navy-700); }
  .rail-head { display: flex; justify-content: space-between; align-items: center; font-family: var(--sans); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; border-bottom: 1px solid var(--rule-dark); padding-bottom: 0.5rem; margin-bottom: 0.4rem; color: var(--gold-400); }
  .pulse { color: var(--red-live); animation: pulse 2s infinite; }
  .rail-head a { color: var(--gold-300); text-decoration: none; font-size: 0.62rem; }
  .rail-item { padding: 0.55rem 0; border-bottom: 1px dotted var(--rule-dark); }
  .rail-item:last-child { border-bottom: none; }
  .rail-top { display: flex; justify-content: space-between; gap: 0.4rem; flex-wrap: wrap; }
  .rail-item p { overflow-wrap: break-word; }
  .rail-time { font-family: var(--sans); font-size: 0.66rem; font-weight: 800; color: var(--gold-400); }
  .rail-kind { font-family: var(--sans); font-size: 0.56rem; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(255,255,255,0.55); }
  .rail-item p { font-size: 0.82rem; margin-top: 0.15rem; color: rgba(248,248,240,0.85); }
  .rail-cta { margin-top: 0.8rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .rail-cta-item { display: flex; gap: 0.5rem; align-items: center; font-family: var(--sans); font-size: 0.72rem; font-weight: 700; text-decoration: none; color: var(--gold-400); background: rgba(255,255,255,0.06); border: 1px solid var(--rule-dark); padding: 0.55rem 0.7rem; border-radius: 2px; }
  .rail-cta-item:hover { border-color: var(--gold-400); }
  .rail-cta-item span { font-size: 0.8rem; }
  .rail-cta-item em { margin-left: auto; font-style: normal; font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.1em; }

  .mosaic { display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  @media (min-width: 820px) { .mosaic { grid-template-columns: 1.6fr 1fr; } }
  .mcard { background: var(--cream); }
  .mcard img { width: 100%; object-fit: cover; display: block; }
  .mcard.large img, .mosaic > .mcard > img { height: 260px; }
  .mbody { padding: 0.9rem 1rem 1rem; }
  .mcard.large h3 { font-size: 1.3rem; line-height: 1.18; margin: 0.4rem 0 0.35rem; }
  .mcard h3 a, .mcard h4 a { text-decoration: none; } .mcard h3 a:hover, .mcard h4 a:hover { color: var(--red-600); }
  .mcard p { font-size: 0.88rem; color: var(--ink-soft); }
  .mcol { display: grid; grid-template-rows: 1fr 1fr; gap: 1px; background: var(--rule); }
  .mcard.small .mbody { padding: 0.75rem 0.9rem; }
  .mcard.small h4 { font-size: 1rem; line-height: 1.25; margin: 0.3rem 0; }
  .sidestory { display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-top: none; margin-bottom: 0.5rem; }
  @media (min-width: 820px) { .sidestory { grid-template-columns: repeat(3, 1fr); } }
  .mcard.tiny { padding: 0.85rem 0.95rem; }
  .mcard.tiny h4 { font-size: 0.95rem; margin: 0.3rem 0 0.2rem; }
  .mcard.tiny p { font-size: 0.8rem; }

  .integrity { display: grid; background: var(--navy-800); color: var(--cream); margin: 1.4rem 0; border: 1px solid var(--navy-700); }
  @media (min-width: 860px) { .integrity { grid-template-columns: 1.5fr 1fr; } }
  .int-copy { padding: 1.6rem 1.5rem; }
  .int-copy h2 { font-size: clamp(1.6rem, 3.4vw, 2.4rem); font-weight: 900; margin: 0.4rem 0 0.5rem; letter-spacing: 0.01em; }
  .int-copy p { color: rgba(248,248,240,0.85); font-size: 0.95rem; }
  .int-stats { display: flex; flex-wrap: wrap; gap: 0.4rem 1.3rem; margin: 0.9rem 0 1.2rem; font-family: var(--sans); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(248,248,240,0.6); }
  .int-stats b { color: var(--gold-400); font-size: 1rem; margin-right: 0.2rem; }
  .int-side { display: flex; flex-direction: column; gap: 0.7rem; padding: 1.6rem 1.3rem; border-left: 1px solid var(--rule-dark); }
  .int-panel { background: rgba(255,255,255,0.06); border-left: 3px solid var(--gold-400); padding: 0.7rem 0.9rem; }
  .ip-head { font-family: var(--sans); font-size: 0.6rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold-400); }
  .int-panel p { font-size: 0.84rem; margin-top: 0.25rem; color: rgba(248,248,240,0.85); }
  .llist { list-style: none; padding: 0; margin-top: 0.3rem; }
  .llist li { margin: 0.2rem 0; }
  .llist a { font-family: var(--sans); font-size: 0.78rem; color: var(--gold-300); text-decoration: none; }
  .llist a:hover { color: var(--gold-400); }

  .bridge { border: 1px solid var(--rule); background: linear-gradient(120deg, rgba(0,156,59,0.07), rgba(30,77,140,0.10)); padding: 1.5rem 1.4rem; margin: 0.4rem 0 1.4rem; }
  .bridge-head { display: flex; align-items: center; gap: 1rem; justify-content: center; }
  .flag-big { font-size: 2.2rem; }
  .bridge-head h2 { font-family: var(--sans); font-weight: 900; font-size: clamp(1.2rem, 3vw, 1.8rem); letter-spacing: 0.06em; text-transform: uppercase; text-align: center; }
  .bridge-deck { text-align: center; max-width: 620px; margin: 0.7rem auto 1rem; color: var(--ink-soft); font-size: 0.95rem; }
  .bridge-links { display: flex; gap: 1.2rem; justify-content: center; flex-wrap: wrap; }
  .bridge-links a { font-family: var(--sans); font-size: 0.78rem; font-weight: 700; color: var(--red-600); text-decoration: none; }

  .today3 { display: grid; gap: 0.9rem; }
  @media (min-width: 820px) { .today3 { grid-template-columns: repeat(3, 1fr); } }

  .verified { border: 1px solid var(--rule); background: var(--cream); padding: 0.7rem 1rem; }
  .vitem { display: flex; gap: 0.9rem; padding: 0.45rem 0; border-bottom: 1px dotted var(--rule); font-size: 0.9rem; align-items: baseline; }
  .vtime { font-family: var(--sans); font-size: 0.68rem; font-weight: 800; color: var(--red-600); white-space: nowrap; }
  .vall { display: inline-block; font-family: var(--sans); font-size: 0.72rem; font-weight: 700; color: var(--blue-link); text-decoration: none; margin-top: 0.5rem; }

  .join { display: flex; justify-content: flex-end; margin: 1.6rem 0 0.5rem; }
  .join-card { border: 1px solid var(--gold-400); background: var(--cream); padding: 1.3rem 1.5rem; max-width: 480px; width: 100%; }
  .join-card h3 { font-size: 1.2rem; margin: 0.35rem 0 0.8rem; }
  .join-row { display: flex; gap: 0.5rem; margin-bottom: 0.6rem; }
  .join-row input { flex: 1; font-family: var(--sans); font-size: 0.8rem; padding: 0.55rem 0.7rem; border: 1px solid var(--rule); background: var(--cream); }
  .join-row input::placeholder { color: var(--ink-soft); }
  .join-row button { font-family: var(--sans); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; padding: 0.55rem 0.9rem; background: var(--ink); color: var(--cream); border: none; cursor: not-allowed; opacity: 0.6; }
</style>

<!-- PHASE C ADDITION — Investigations band -->
<section aria-label="Investigations" class="investigations-section">
  <div class="section-h"><h2>T.O.U.R. Investigates</h2><a href="/dossier/banco-master/" class="sub">Follow the money →</a></div>
  <div class="grid-2">
    <a href="/dossier/banco-master/" class="ecard current">
      <div class="ec-top"><span class="ec-time">Dossier</span><span class="ec-status">EVIDENCE-GRADED</span></div>
      <div class="ec-name">Banco Master / Mendonça / Moraes</div>
      <h3 class="ec-headline">Mutual-suspension spiral — what the plenary can decide</h3>
      <div class="ec-meta"><span>Investigation</span><span>Primary documents</span><span>Timeline</span></div>
    </a>
    <a href="/editions/" class="ecard">
      <div class="ec-top"><span class="ec-time">Edition</span><span class="ec-status">LATEST</span></div>
      <div class="ec-name">2026-09-07 Morning</div>
      <h3 class="ec-headline">Mutual suspension request + PGR brief + rally clock</h3>
      <div class="ec-meta"><span>Morning Brief</span><span>1:30 audio</span></div>
    </a>
  </div>
</section>

<!-- WIREFRAME SECTIONS (user design): Brazil↔USA / AI&Tech / T.O.U.R. Show -->
