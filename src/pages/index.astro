---
// HOMEPAGE V6 — T.O.U.R. News. Clean newspaper front page matching the approved cover:
// breaking ticker, bulldog-anchor hero with WORKING audio player, top stories, dossier block.
import TourBase from '../layouts/TourBase.astro';
import EvidenceLabel from '../components/EvidenceLabel.astro';
import EditionAudio from '../components/EditionAudio.astro';
import EditionCard from '../components/EditionCard.astro';
import dossier from '../data/dossier-banco-master.json';
import editionsIndex from '../data/editions-index.json';

const current = editionsIndex.editions[0];
const lead = current.leadStory;
const typeLabel = current.type === 'morning' ? 'MORNING BRIEF' : current.type === 'midday' ? 'MIDDAY UPDATE' : 'EVENING EDITION';

// Real audio for the current edition (morning 07 = real mp3)
const audioSrc = `/audio/${current.id}.mp3`;
const audioDur = current.audio || '1:30';

const changed = current.whatChanged || [];
const tickerItems = changed.slice(0, 3).map(c => ({ time: (c.time || '').padStart(5, '0'), text: c.text }));
const renderTicker = tickerItems.length
  ? tickerItems
  : [{ time: '—', text: 'Dossier monitoring continues — no material alert this window.' }];

const topStories = [
  { tag: 'Brazil Public Integrity', accent: '#7c2d12', size: 'large',
    headline: lead.headline, deck: lead.deck, img: current.cover, href: lead.href },
  { tag: 'UNITED STATES', accent: '#1e3a8a', size: 'small',
    headline: 'Watchlist: four flashpoints entering a volatile month',
    deck: 'Confirmed deployments only — monitoring desk.', img: '/media/tour-world-globe.jpg', href: '/topics#world' },
  { tag: 'BRAZIL', accent: '#166534', size: 'small',
    headline: 'Congress returns with three integrity probes on the calendar',
    deck: 'What each one can actually subpoena.', img: null, href: '/topics#brazil' },
];
const largeStory = topStories.find(s => s.size === 'large');
const smallStories = topStories.filter(s => s.size === 'small');

const docs = [
  { title: 'PF forensic report (IPJ-A)', meta: 'Polícia Federal · Aug 27, 2026', href: '/dossier/banco-master' },
  { title: 'Barci de Moraes ↔ Banco Master contract', meta: 'Case file PET 16662 · 2024', href: '/dossier/banco-master' },
  { title: 'Fachin order (despacho)', meta: 'STF Presidency · Sep 3, 2026', href: '/dossier/banco-master' },
  { title: 'PGR manifestation', meta: 'PGR/ASSCRIM · Sep 2026', href: '/dossier/banco-master' },
];
---
<TourBase activeNav="home">
  <!-- BREAKING TICKER -->
  <div class="breaking-bar" slot="ticker">
    <span class="breaking-label"><span class="bl-dot"></span>BREAKING</span>
    <div class="breaking-items">
      {renderTicker.map((u, i) => (
        <span class="breaking-item" key={i}><b>{u.time} CT</b> — {u.text.slice(0, 110)}{u.text.length > 110 ? '…' : ''}</span>
      ))}
    </div>
  </div>

  <!-- BULLDOG-ANCHOR HERO (image-led, working player) -->
  <section class="hero-zone">
    <article class="hero-main">
      <div class="hero-img"><img src={current.cover} alt={current.coverAlt} fetchpriority="high" /></div>
      <div class="hero-scrim"></div>
      <div class="hero-content">
        <div class="hero-topline">
          <span class="hero-badge">{typeLabel}</span>
          <span class="hero-kind">DEVELOPING · {current.publishTime} CT</span>
        </div>
        <h1><a href={lead.href}>{lead.headline}</a></h1>
        <p class="deck">{lead.deck}</p>
        <div class="cta-row">
          <a class="btn solid" href={lead.href}>READ</a>
          <a class="btn gold" href={`/editions/${current.id}/`}>▶ LISTEN</a>
          <a class="btn inkline" href="/dossier/banco-master">SEE RECEIPTS</a>
        </div>
      </div>
    </article>
  </section>

  <!-- WORKING AUDIO PLAYER (not a dead link) -->
  <EditionAudio src={audioSrc} duration={audioDur} title={`${typeLabel} — audio brief`} date={current.date} />

  <!-- TOP STORIES MOSAIC -->
  <div class="section-h"><h2>Top stories</h2><span class="sub">graded · sourced · current</span></div>
  <section class="mosaic">
    <article class="mcard large">
      {largeStory.img && <img src={largeStory.img} alt="" loading="lazy" />}
      <div class="mbody">
        <span class="chip" style={`color:${largeStory.accent}`}>{largeStory.tag}</span>
        <h3><a href={largeStory.href}>{largeStory.headline}</a></h3>
        <p>{largeStory.deck}</p>
      </div>
    </article>
    <div class="mcol">
      {smallStories.map((s) => (
        <article class="mcard small">
          {s.img && <img src={s.img} alt="" loading="lazy" />}
          <div class="mbody">
            <span class="chip" style={`color:${s.accent}`}>{s.tag}</span>
            <h4><a href={s.href}>{s.headline}</a></h4>
            <p>{s.deck}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- INVESTIGATIONS / DOSSIER BLOCK -->
  <section class="integrity">
    <div class="int-copy">
      <span class="kicker" style="color:var(--gold-400)">Investigations</span>
      <h2>BANCO MASTER <span style="color:var(--gold-400)">— THE DOSSIER</span></h2>
      <p>The banker, the justice, and 52 messages. What a 218-page police forensic report proves — and what it merely suggests. Updated as documents land.</p>
      <div class="int-stats">
        <span><b>{dossier.known_facts.length}</b> verified facts</span>
        <span><b>{dossier.primary_sources.length}</b> documents</span>
        <span><b>{dossier.timeline.length}</b> timeline events</span>
        <span><b>{dossier.contradictions.length}</b> contradictions</span>
      </div>
      <a class="btn gold" href="/dossier/banco-master">OPEN THE DOSSIER</a>
    </div>
    <div class="int-side">
      <div class="int-panel">
        <span class="ip-head">WHAT WE KNOW</span>
        <p>52 one-way messages exist (PF doc). The contract exists (primary doc). Reply content was never recovered.</p>
      </div>
      <div class="int-panel">
        <span class="ip-head">DOCUMENTS ON FILE</span>
        <ul class="llist">{docs.map(d => (<li><a href={d.href}>{d.title} →</a></li>))}</ul>
      </div>
    </div>
  </section>

  <!-- THE DAILY DESK -->
  <div class="section-h"><h2>The Daily Desk</h2><span class="sub">three briefings every day · <a href="/editions/" style="color:var(--red-600)">all editions →</a></span></div>
  <section class="today3">
    <EditionCard type="morning" time="07:00" status="PUBLISHED" cover="/media/hero-banco-master-9x16.jpg" headline={current.leadHeadline} storyCount={current.storyCount} readingMin={current.readingMin} updatedTime={current.updatedAt.slice(11,16)} href={`/editions/${current.id}/`} audio={current.audio} />
    <EditionCard type="midday" time="13:00" status="NEXT EDITION" cover="/media/thumbs/pgr-brief.png" headline="PGR manifestação lands on the case file" updateCount={current.whatChanged.length} />
    <EditionCard type="evening" time="19:00" status="UPCOMING" cover={current.cover} headline="Evening wrap: what mattered today + overnight watch" />
  </section>

  <!-- LATEST VERIFIED -->
  <div class="section-h"><h2>Latest verified</h2><span class="sub">fact-first · no commentary</span></div>
  <section class="verified">
    {changed.map((u, i) => (
      <div class="vitem" key={i}><span class="vtime">{(u.time || '').padStart(5, '0')} CT</span><span class="vtext">{u.text}</span></div>
    ))}
    <a class="vall" href="/dossier/banco-master">View all verified updates →</a>
  </section>
</TourBase>

<style is:global>
  .hero-zone { margin-bottom: 0.9rem; }
  .hero-main { position: relative; overflow: hidden; min-height: 380px; background: var(--navy-700); }
  .hero-img { position: absolute; inset: 0; } .hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-scrim { position: absolute; inset: 0; background: linear-gradient(transparent 35%, rgba(0,16,48,0.88) 88%); }
  .hero-content { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 1.4rem 1.4rem 1.5rem; color: #fff; }
  .hero-topline { display: flex; gap: 0.6rem; align-items: center; margin-bottom: 0.55rem; }
  .hero-badge { font-family: var(--sans); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; background: var(--red-600); color: #fff; padding: 0.18rem 0.55rem; border-radius: 2px; }
  .hero-kind { font-family: var(--sans); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-400); }
  .hero-content h1 { font-size: clamp(1.6rem, 3.4vw, 2.4rem); line-height: 1.1; margin: 0 0 0.4rem; letter-spacing: -0.01em; }
  .hero-content h1 a { color: var(--paper); text-decoration: none; text-shadow: 0 2px 10px rgba(0,0,0,0.4); }
  .hero-content .deck { font-size: 1rem; color: rgba(248,248,240,0.9); max-width: 60ch; text-shadow: 0 1px 6px rgba(0,0,0,0.4); }
  .cta-row { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1rem; }
  .btn.inkline { border-color: rgba(255,255,255,0.6); color: #fff; }
  .eaudio { margin-bottom: 1rem; }

  .mosaic { display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  @media (min-width: 820px) { .mosaic { grid-template-columns: 1.6fr 1fr; } }
  .mcard { background: var(--paper); } .mcard img { width: 100%; object-fit: cover; display: block; }
  .mcard.large img { height: 250px; } .mcard.small img { height: 150px; }
  .mbody { padding: 0.9rem 1rem 1rem; }
  .mcard.large h3 { font-size: 1.3rem; line-height: 1.18; margin: 0.4rem 0 0.35rem; }
  .mcard h3 a, .mcard h4 a { text-decoration: none; } .mcard h3 a:hover, .mcard h4 a:hover { color: var(--red-600); }
  .mcard p { font-size: 0.88rem; color: var(--ink-soft); }
  .mcol { display: grid; grid-template-rows: 1fr; gap: 1px; background: var(--rule); }
  .mcard.small .mbody { padding: 0.75rem 0.9rem; }
  .mcard.small h4 { font-size: 1rem; line-height: 1.25; margin: 0.3rem 0; }

  .integrity { display: grid; background: var(--navy-800); color: var(--paper); margin: 1.4rem 0; border: 1px solid var(--navy-700); }
  @media (min-width: 860px) { .integrity { grid-template-columns: 1.5fr 1fr; } }
  .int-copy { padding: 1.6rem 1.5rem; }
  .int-copy h2 { font-size: clamp(1.6rem, 3.4vw, 2.4rem); font-weight: 900; margin: 0.4rem 0 0.5rem; letter-spacing: 0.01em; }
  .int-copy p { color: rgba(248,248,240,0.85); font-size: 0.95rem; }
  .int-stats { display: flex; flex-wrap: wrap; gap: 0.4rem 1.3rem; margin: 0.9rem 0 1.2rem; font-family: var(--sans); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(248,248,240,0.6); }
  .int-stats b { color: var(--gold-400); font-size: 1rem; margin-right: 0.2rem; }
  .int-side { display: flex; flex-direction: column; gap: 0.7rem; padding: 1.6rem 1.3rem; border-left: 1px solid var(--rule-dark); }
  .int-panel { background: rgba(255,255,255,0.06); border-left: 3px solid var(--gold-400); padding: 0.7rem 0.9rem; }
  .ip-head { font-family: var(--sans); font-size: 0.6rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold-400); }
  .int-panel p { font-size: 0.84rem; margin-top: 0.25rem; color: rgba(248,248,240,0.85); }
  .llist { list-style: none; padding: 0; margin-top: 0.3rem; }
  .llist li { margin: 0.2rem 0; } .llist a { font-family: var(--sans); font-size: 0.78rem; color: var(--gold-300); text-decoration: none; }

  .today3 { display: grid; gap: 0.9rem; }
  @media (min-width: 820px) { .today3 { grid-template-columns: repeat(3, 1fr); } }

  .verified { border: 1px solid var(--rule); background: var(--paper); padding: 0.7rem 1rem; }
  .vitem { display: flex; gap: 0.9rem; padding: 0.45rem 0; border-bottom: 1px dotted var(--rule); font-size: 0.9rem; align-items: baseline; }
  .vtime { font-family: var(--sans); font-size: 0.68rem; font-weight: 800; color: var(--red-600); white-space: nowrap; }
  .vall { display: inline-block; font-family: var(--sans); font-size: 0.72rem; font-weight: 700; color: var(--blue-link); text-decoration: none; margin-top: 0.5rem; }
</style>