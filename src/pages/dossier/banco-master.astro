---
// Dossier page — investigation dossier on Base layout with stat cards
import TourBase from '../../layouts/TourBase.astro';
import dossier from '../../data/dossier-banco-master.json';
const clsColor: Record<string,string> = {
  'PRIMARY DOCUMENT':'#1d4ed8','CONFIRMED FACT':'#166534','OFFICIAL POSITION':'#1e40af',
  'CORROBORATED':'#166534','MEDIA REPORT':'#6b7280','ALLEGATION':'#b45309',
  'PRIMARY_DOC_CONFIRMED':'#1d4ed8','OFFICIAL_POSITION':'#1e40af','NEGATIVE_FINDING':'#6b7280',
};
const colorFor = (c: string) => clsColor[c] || '#6b7280';
const stats = [
  { n: dossier.known_facts.length, label: 'Graded facts' },
  { n: dossier.timeline.length, label: 'Timeline events' },
  { n: dossier.entities.length, label: 'Entities mapped' },
  { n: dossier.primary_sources.length, label: 'Primary documents' },
  { n: dossier.contradictions.length, label: 'Contradictions' },
  { n: dossier.open_questions.length, label: 'Open questions' },
];
---
<TourBase title={`${dossier.id} — Dossier | TOTO GLOBAL DESK`} desc={dossier.overview.slice(0,150)}>
  <style>
    .head { max-width: var(--measure); margin: 0 auto; }
    .kicker-line { display:flex; gap:.4rem; align-items:center; }
    h1.dosstitle { font-size: clamp(1.5rem, 3.5vw, 2.2rem); line-height:1.16; margin:.55rem 0 .5rem; }
    .stamp-row { display:flex; gap:1.1rem; flex-wrap:wrap; padding:.55rem 0; border-top:1px solid var(--rule); border-bottom:1px solid var(--rule); }
    .statrow { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--rule); border:1px solid var(--rule); margin:1.2rem 0; }
    @media (min-width:640px){ .statrow { grid-template-columns:repeat(6,1fr); } }
    .stat { background:var(--paper); padding:.7rem .5rem; text-align:center; }
    .stat b { display:block; font-size:1.45rem; color:var(--accent); font-family:var(--sans); }
    .stat span { font-family:var(--sans); font-size:.6rem; text-transform:uppercase; letter-spacing:.08em; color:var(--ink-soft); }
    .wrap { max-width: var(--measure); margin: 0 auto; }
    h2.sec { font-family:var(--sans); font-size:.95rem; text-transform:uppercase; letter-spacing:.11em; margin:2rem 0 .6rem; border-bottom:2px solid var(--ink); padding-bottom:.3rem; }
    h2.sec span { float:right; font-weight:400; font-size:.72rem; color:var(--ink-soft); }
    .overview { font-size:1.06rem; }
    .fact { padding:.65rem 0; border-bottom:1px dotted var(--rule); }
    .fact p { margin:.3rem 0; font-size:.99rem; }
    .grade { font-family:var(--sans); font-size:.62rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; padding:.1rem .42rem; border:1px solid currentColor; border-radius:2px; }
    .src { font-family:var(--sans); font-size:.72rem; color:var(--ink-soft); }
    ol.tl { list-style:none; padding:0; }
    ol.tl li { padding:.5rem 0 .5rem 7.2rem; position:relative; border-bottom:1px dotted var(--rule); font-size:.93rem; }
    ol.tl li::before { content:attr(data-date); position:absolute; left:0; font-family:var(--sans); font-weight:700; font-size:.72rem; color:var(--accent); top:.58rem; }
    .con { background:var(--paper-2); border:1px solid var(--gold,#a16207); border-left:4px solid #a16207; border-radius:3px; padding:.75rem 1rem; margin:.6rem 0; font-size:.9rem; }
    .con .tag { font-family:var(--sans); font-size:.62rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:#a16207; }
    .egrid { display:grid; gap:.5rem; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); }
    .ent { background:var(--paper-2); border:1px solid var(--rule-soft); border-radius:3px; padding:.55rem .7rem; font-size:.85rem; }
    .ent b { display:block; } .ent span { font-family:var(--sans); font-size:.7rem; color:var(--ink-soft); }
    .docs li { margin:.4rem 0; font-size:.92rem; }
    .next { font-family:var(--sans); font-size:.82rem; margin-top:2rem; }
    .next a { color:var(--accent); font-weight:700; text-decoration:none; }
  </style>
  <article>
    <div class="head">
      <div class="kicker-line"><span class="kicker">Dossier · Brazil Public Integrity</span></div>
      <h1 class="dosstitle">{dossier.title}</h1>
      <div class="stamp-row">
        <span class="stamp">ID {dossier.id}</span><span class="stamp">Status {dossier.status}</span>
        <span class="stamp">Priority {dossier.priority}</span><span class="stamp">Updated {dossier.last_updated.slice(0,10)}</span>
      </div>
    </div>
    <div class="statrow">
      {stats.map((s) => <div class="stat"><b>{s.n}</b><span>{s.label}</span></div>)}
    </div>
    <div class="wrap">
      <p class="overview">{dossier.overview}</p>

      <h2 class="sec">Known facts <span>each graded</span></h2>
      {dossier.known_facts.map((f) => (
        <div class="fact">
          <span class="grade" style={`color:${colorFor(f.classification)}`}>{f.classification}</span>
          <p>{f.fact}</p>
          <span class="src">{f.date && `— ${f.date}`} {f.source && `· ${f.source}`}</span>
        </div>
      ))}

      <h2 class="sec">Timeline <span>{dossier.timeline.length} events</span></h2>
      <ol class="tl">
        {dossier.timeline.map((t) => <li data-date={t.date}>{t.event}</li>)}
      </ol>

      <h2 class="sec">Entities <span>{dossier.entities.length} mapped</span></h2>
      <div class="egrid">
        {dossier.entities.map((e) => <div class="ent"><b>{e.name}</b><span>{e.role}</span></div>)}
      </div>

      <h2 class="sec">Contradictions <span>{dossier.contradictions.length} tracked</span></h2>
      {dossier.contradictions.map((x) => (
        <div class="con">
          <div class="tag">Contradiction · confidence {x.confidence}</div>
          <p><strong>A:</strong> {x.claim_a ?? x.a}</p>
          <p><strong>B:</strong> {x.claim_b ?? x.b}</p>
          <p><strong>Assessment:</strong> {x.assessment}</p>
        </div>
      ))}

      <h2 class="sec">Primary documents <span>{dossier.primary_sources.length} on file</span></h2>
      <ul class="docs">
        {dossier.primary_sources.map((s) => (
          <li>📄 <strong>{s.title}</strong> — {s.issuer}, {s.date} <span class="src">({s.url_or_path})</span></li>
        ))}
      </ul>

      <h2 class="sec">Open questions <span>{dossier.open_questions.length}</span></h2>
      <ul class="docs">
        {dossier.open_questions.map((q) => <li>❓ {q}</li>)}
      </ul>

      <h2 class="sec">What-changed log <span>{dossier.updates.length} entries</span></h2>
      {dossier.updates.map((u) => (
        <div class="fact">
          <span class="grade" style="color:#1d4ed8">Update</span>
          <p>{u.what_changed}</p>
          <span class="src">{u.ts}</span>
        </div>
      ))}

      <p class="next"><a href="/story/banco-master">← Read the investigation</a> · <a href="/topics">All desks →</a></p>
    </div>
  </article>
</TourBase>
<!-- end dossier -->
