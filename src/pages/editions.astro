---
// Editions — schedule page on Base layout
import Base from '../layouts/Base.astro';
const slots = [
  { time: '07:00', name: 'Morning Edition', focus: 'What happened overnight · What matters today · What to watch', icon: '🌅' },
  { time: '13:00', name: 'Midday Edition', focus: 'Changes since morning · Live developments · Corrections & new evidence', icon: '☀️' },
  { time: '19:00', name: 'Evening Edition', focus: 'The day in full · What matters most · Unresolved · Overnight watch', icon: '🌙' },
];
---
<Base title="Editions | TOTO GLOBAL DESK" desc="Three guaranteed daily editions plus condition-driven breaking alerts. Central Time.">
  <style>
    .notice { background:var(--paper-2); border:1px solid var(--rule); border-left:4px solid var(--accent-2); border-radius:3px; padding:.85rem 1.1rem; font-family:var(--sans); font-size:.85rem; margin-bottom:1.3rem; }
    .slot { display:grid; grid-template-columns:5.2rem 1fr; gap:1rem; background:var(--paper); border:1px solid var(--rule); border-radius:3px; padding:1rem 1.1rem; margin:.7rem 0; }
    .slot .time { font-size:1.7rem; font-weight:800; color:var(--accent); font-family:var(--sans); line-height:1; }
    .slot .time small { display:block; font-size:.6rem; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-soft); margin-top:.25rem; }
    .slot h3 { font-family:var(--sans); font-size:.9rem; text-transform:uppercase; letter-spacing:.12em; }
    .slot .focus { font-size:.92rem; color:var(--ink-soft); font-style:italic; margin-top:.25rem; }
    .slot .state { display:inline-block; font-family:var(--sans); font-size:.6rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; padding:.14rem .45rem; border:1px solid var(--accent-2); color:var(--accent-2); border-radius:2px; margin-top:.45rem; }
    .special { border-left:4px solid var(--rule); }
    h2.sec { font-family:var(--sans); font-size:.95rem; text-transform:uppercase; letter-spacing:.11em; border-bottom:2px solid var(--ink); padding-bottom:.3rem; margin:1.9rem 0 .8rem; }
  </style>
  <div class="section-h">Daily editions <span class="sub">guaranteed · Central Time</span></div>
  <div class="notice">📰 <strong>Editions begin with Phase 3.</strong> The editorial pipeline is built (scout → verify → red-team → editor). Breaking alerts never wait for editions.</div>
  {slots.map((s) => (
    <div class="slot">
      <div class="time">{s.time}<small>CT</small></div>
      <div>
        <h3>{s.icon} {s.name}</h3>
        <div class="focus">{s.focus}</div>
        <span class="state">Starting Phase 3</span>
      </div>
    </div>
  ))}
  <h2 class="sec">Also published</h2>
  <div class="slot special">
    <div class="time" style="color:#dc2626">⚡</div>
    <div><h3>Breaking alerts</h3>
      <div class="focus">Condition-driven only: major rulings, decisions, enforcement actions, emergencies. Deduplicated against story memory — no material change, no alert.</div></div>
  </div>
  <div class="slot special">
    <div class="time" style="color:#a16207">✎</div>
    <div><h3>Corrections</h3>
      <div class="focus">Visible, logged, never silent. What was wrong, what changed, why, with sources.</div></div>
  </div>
</Base>
