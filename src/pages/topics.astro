---
// Topics — desk cards with counts on Base layout
import TourBase from '../layouts/TourBase.astro';
import dossier from '../data/dossier-banco-master.json';
const desks = [
  { slug: 'us-immigration', name: 'US Immigration', accent: '#b91c1c', blurb: 'ICE, USCIS, DHS, DOJ, EOIR and the federal courts — policy and enforcement, tracked daily.' },
  { slug: 'united-states', name: 'United States', accent: '#1e3a8a', blurb: 'Federal policy, White House actions, major national developments.' },
  { slug: 'brazil', name: 'Brazil', accent: '#166534', blurb: 'Government, Congress, courts and the major political-legal developments of the day.' },
  { slug: 'brazil-public-integrity', name: 'Brazil Public Integrity', accent: '#7c2d12', blurb: 'Investigations, public money, documented financial relationships — evidence-first.' },
  { slug: 'world', name: 'World', accent: '#374151', blurb: 'Diplomacy, geopolitics and major international developments.' },
  { slug: 'war-security', name: 'War & Security', accent: '#57534e', blurb: 'Armed conflicts, security crises, sanctions — confirmed developments over rumor.' },
];
const deskStories: Record<string, any[]> = {
  'brazil-public-integrity': [{
    id: dossier.id, title: dossier.title, href: '/dossier/banco-master', storyHref: '/story/banco-master',
    facts: dossier.known_facts.length, events: dossier.timeline.length, docs: dossier.primary_sources.length,
    updated: dossier.last_updated.slice(0, 10), chip: 'Active dossier', chipColor: '#7c2d12',
  }],
  'brazil': [{
    title: 'Crise do STF: suspensões recíprocas entre ministros', href: '/story/banco-master', storyHref: '/story/banco-master',
    facts: '7', events: '8', docs: '4', updated: '2026-09-07', chip: 'Active', chipColor: '#166534',
  }],
  'united-states': [{
    title: 'Watchlist: four flashpoints entering a volatile month', href: '/topics#united-states', storyHref: '/topics#united-states',
    facts: '—', events: '4', docs: '0', updated: '2026-09-06', chip: 'Monitoring', chipColor: '#1e3a8a',
  }],
  'world': [{
    title: 'Diplomacy desk: trade, security and international flashpoints', href: '/topics#world', storyHref: '/topics#world',
    facts: '—', events: '3', docs: '0', updated: '2026-09-06', chip: 'Monitoring', chipColor: '#374151',
  }],
  'war-security': [{
    title: 'Sanctions and conflict log — confirmed developments only', href: '/topics#war-security', storyHref: '/topics#war-security',
    facts: '—', events: '2', docs: '0', updated: '2026-09-06', chip: 'Monitoring', chipColor: '#57534e',
  }],
  'us-immigration': [{
    title: 'Worksite raid playbook, annotated — every step public record', href: '/topics#us-immigration', storyHref: '/topics#us-immigration',
    facts: '—', events: '5', docs: '0', updated: '2026-09-06', chip: 'Monitoring', chipColor: '#b91c1c',
  }],
};
---
<TourBase title="Topics &amp; Desks | TOTO GLOBAL DESK">
  <style>
    .desksec { margin: 1.8rem 0 2.2rem; }
    .deskhead { display:flex; align-items:baseline; gap:.6rem; border-bottom:3px solid var(--desk-accent); padding-bottom:.35rem; margin-bottom:.7rem; }
    .deskhead .dot { width:.6rem; height:.6rem; background:var(--desk-accent); border-radius:50%; align-self:center; }
    .deskhead h2 { font-family:var(--sans); font-size:.95rem; font-weight:800; text-transform:uppercase; letter-spacing:.12em; margin:0; }
    .deskhead .blurb { font-size:.8rem; color:var(--ink-soft); font-style:italic; margin-left:auto; text-align:right; }
    .story { padding:.75rem 0; border-bottom:1px dotted var(--rule); }
    .story h3 { font-size:1.15rem; margin:.35rem 0; } .story h3 a { text-decoration:none; } .story h3 a:hover { color:var(--accent); }
    .chip { display:inline-block; font-family:var(--sans); font-size:.62rem; font-weight:700; letter-spacing:.1em; padding:.15rem .5rem; border:1px solid currentColor; border-radius:2px; text-transform:uppercase; }
    .meta { font-family:var(--sans); font-size:.7rem; color:var(--ink-soft); margin-top:.3rem; }
    .meta a { color:var(--accent); text-decoration:none; font-weight:700; }
    .empty { font-size:.9rem; color:var(--ink-soft); font-style:italic; padding:.55rem 0; border-bottom:1px dotted var(--rule); }
  </style>
  <div class="pagehead"><h1>Topics &amp; Desks</h1><p class="ph-sub">Per Marc's watchlist · extendable any time</p></div>
  {desks.map((d) => (
    <section class="desksec" id={d.slug}>
      <div class="deskhead" style={`--desk-accent:${d.accent}`}>
        <span class="dot"></span><h2>{d.name}</h2>
        <span class="blurb">{d.blurb}</span>
      </div>
      {(deskStories[d.slug] || []).map((s) => (
        <div class="story">
          <span class="chip" style={`color:${d.accent}`}>{d.name}</span>
          <span class="chip" style={`color:${s.chipColor || d.accent}`}>{s.chip || 'Monitoring'}</span>
          <h3><a href={s.storyHref}>{s.title}</a></h3>
          <p class="meta">{s.facts} facts · {s.events} events · {s.docs} documents · updated {s.updated} · <a href={s.href}>open →</a></p>
        </div>
      ))}
      {!(deskStories[d.slug] || []).length && <div class="empty">No stories on this desk yet — monitoring active. Coverage begins with the first edition cycle.</div>}
    </section>
  ))}
</TourBase>
