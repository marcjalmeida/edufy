---
// Topics index — all desk sections with their stories/dossiers
import { desks, esc } from '../lib/newsroom.js';
import dossier from '../data/dossier-banco-master.json';
import queue from '../data/queue.json';

const deskStories = {
  'brazil-public-integrity': [{
    id: dossier.id, headline: dossier.title, deck: dossier.overview.slice(0, 180) + '…',
    status: 'ACTIVE', updated: dossier.last_updated, href: '/dossier/banco-master',
    facts: dossier.known_facts.length, events: dossier.timeline.length, docs: dossier.primary_sources.length,
  }],
};
const others = Object.fromEntries(desks.map(d => [d.slug, []]));
---
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Topics | TOTO GLOBAL DESK</title>
    <style>
      :root { --ink:#111; --paper:#fafaf7; --rule:#d4d4c8; --accent:#8b0000; }
      * { box-sizing:border-box; margin:0; }
      body { font-family:Georgia,serif; background:var(--paper); color:var(--ink); line-height:1.55; }
      header { border-bottom:3px double var(--ink); padding:1.5rem 1rem 1rem; text-align:center; }
      header a { font-family:-apple-system,Arial,sans-serif; font-size:.72rem; letter-spacing:.28em; text-transform:uppercase; color:#555; text-decoration:none; }
      header h1 { font-size:1.4rem; letter-spacing:.04em; margin-top:.4rem; }
      main { max-width:1000px; margin:0 auto; padding:1.5rem 1rem; }
      h2 { font-size:1.05rem; font-family:-apple-system,Arial,sans-serif; text-transform:uppercase; letter-spacing:.12em; padding:.4rem 0; border-bottom:3px solid var(--ink); margin:1.8rem 0 .8rem; }
      h2 span { color:var(--accent); }
      .story { padding:.8rem 0; border-bottom:1px dotted var(--rule); }
      .story h3 { font-size:1.12rem; margin:.3rem 0; }
      .story h3 a { color:var(--ink); text-decoration:none; }
      .story h3 a:hover { color:var(--accent); }
      .story .deck { font-size:.95rem; color:#444; font-style:italic; }
      .chip { display:inline-block; font-family:-apple-system,Arial,sans-serif; font-size:.62rem; font-weight:700; letter-spacing:.1em; padding:.15rem .5rem; border:1px solid currentColor; border-radius:2px; text-transform:uppercase; }
      .meta { font-family:-apple-system,Arial,sans-serif; font-size:.72rem; color:#666; margin-top:.3rem; }
      .empty { font-size:.9rem; color:#777; font-style:italic; padding:.5rem 0; border-bottom:1px dotted var(--rule); }
      footer { border-top:3px double var(--ink); margin-top:2rem; padding:1rem; text-align:center; font-family:-apple-system,Arial,sans-serif; font-size:.72rem; color:#666; }
    </style>
  </head>
  <body>
    <header>
      <a href="/">← TOTO GLOBAL DESK</a>
      <h1>Topics &amp; Desks</h1>
    </header>
    <main>
      {desks.filter(d => d.slug !== 'breaking').map((d) => (
        <>
          <h2 style={`border-bottom-color:${d.accent}`}><span style={`color:${d.accent}`}>●</span> {d.name}</h2>
          {(deskStories[d.slug] || []).map((s) => (
            <div class="story">
              <span class="chip" style={`color:${d.accent}`}>{d.name}</span>
              <span class="chip status" style="color:#92400e">{s.status}</span>
              <h3><a href={s.href}>{s.headline}</a></h3>
              <p class="deck">{s.deck}</p>
              <p class="meta">{s.facts} graded facts · {s.events} timeline events · {s.docs} primary documents · updated {s.updated}</p>
            </div>
          ))}
          {!(deskStories[d.slug] || []).length && <div class="empty">No stories on this desk yet — monitoring active. Scout coverage begins with the first edition cycle.</div>}
        </>
      ))}
    </main>
    <footer>TOTO GLOBAL DESK · {queue.stories.length} active editorial queue item(s) · Coverage areas per Marc's watchlist</footer>
  </body>
</html>
