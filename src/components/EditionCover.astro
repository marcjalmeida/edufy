---
// EditionCover — reusable visual cover for an edition (hero + archive cards)
interface Props {
  type: 'morning' | 'midday' | 'evening';
  cover: string;
  coverAlt: string;
  compact?: boolean;
}
const { type, cover, coverAlt, compact = false } = Astro.props;
const treatments: Record<string, {overlay: string; chipBg: string; label: string}> = {
  morning: { overlay: 'linear-gradient(180deg, rgba(255,190,120,0.18), rgba(20,15,8,0.55))', chipBg: '#b45309', label: 'MORNING BRIEF' },
  midday:  { overlay: 'linear-gradient(180deg, rgba(120,180,255,0.12), rgba(12,14,20,0.55))', chipBg: '#1e40af', label: 'MIDDAY UPDATE' },
  evening: { overlay: 'linear-gradient(180deg, rgba(60,40,90,0.16), rgba(10,8,14,0.62))', chipBg: '#4c1d95', label: 'EVENING EDITION' },
};
const t = treatments[type] || treatments.evening;
---
<div class={`ecover ${compact ? 'compact' : ''}`} data-type={type}>
  <img src={cover} alt={coverAlt} loading="lazy" />
  <span class="ecover-chip" style={`background:${t.chipBg}`}>{t.label}</span>
</div>
<style>
  .ecover { position: relative; overflow: hidden; border-radius: 2px; }
  .ecover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ecover::after { content: ''; position: absolute; inset: 0; background: var(--overlay, none); }
  .ecover[data-type="morning"]::after { background: linear-gradient(180deg, rgba(255,190,120,0.16), rgba(20,15,8,0.55)); }
  .ecover[data-type="midday"]::after  { background: linear-gradient(180deg, rgba(120,180,255,0.10), rgba(12,14,20,0.52)); }
  .ecover[data-type="evening"]::after { background: linear-gradient(180deg, rgba(70,45,110,0.14), rgba(10,8,14,0.60)); }
  .ecover-chip { position: absolute; top: 0.55rem; left: 0.55rem; z-index: 2; font-family: var(--sans); font-size: 0.56rem; font-weight: 800; letter-spacing: 0.14em; color: #fff; padding: 0.16rem 0.5rem; border-radius: 2px; }
  .ecover.compact img { aspect-ratio: 16/9; }
</style>
